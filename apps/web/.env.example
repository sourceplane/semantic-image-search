# Local development. Copy to .env.local (git-ignored); never commit a value.
#
# DATABASE_URL is read by `pnpm --filter @app/web db:migrate:local` (which
# applies packages/db's migrations to a local Postgres with pgvector) and by
# the app only when no Cloudflare context is available. Under `next dev` and
# `wrangler dev` the app reads the HYPERDRIVE binding from wrangler.jsonc
# instead (its localConnectionString — point both at the same database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/images
# Optional: the site's public origin, which the page's Open Graph image link
# is resolved against. The Orun build sets it per environment
# (component.yaml); unset, it is http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
