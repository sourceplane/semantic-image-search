    "drizzle-orm": "0.38.4",
    "geist": "1.5.1",
    "lucide-react": "0.468.0",
    "nanoid": "5.1.6",
    "next": "16.3.8",
    "postgres": "3.4.7",
    "react": "19.0.4",
    "react-dom": "19.0.4",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "use-debounce": "10.0.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "wrangler": "^4.151.0"
  }
