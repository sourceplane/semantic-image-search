{
  "name": "@app/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && opennextjs-cloudflare build --skipBuild --skipWranglerConfigCheck && node scripts/populate-static-assets-cache.mjs",
    "start": "next start",
    "preview": "opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env stage",
    "db:migrate:local": "node ../../tooling/migrations/apply-local.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.11",
    "@radix-ui/react-slot": "1.2.4",
